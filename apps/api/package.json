{
  "name": "@fairtable/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsup",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fairtable/domain": "workspace:*",
    "fastify": "5.12.5",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "tsup": "8.5.1"
  }
}
