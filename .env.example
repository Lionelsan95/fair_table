# Copy to .env at repository root. No API keys required.
PORT=3001
# Published Docker port (localhost only).
WEB_PORT=8080
WEB_ORIGIN=http://localhost:5173
USE_MOCK_PROVIDERS=false
GEOPLATFORM_GEOCODING_BASE_URL=https://data.geopf.fr/geocodage/search
GEOPLATFORM_AUTOCOMPLETE_BASE_URL=https://data.geopf.fr/geocodage/completion/
GEOPLATFORM_ROUTING_BASE_URL=https://data.geopf.fr/navigation/itineraire
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
SHORTLIST_SIZE=8
FINAL_RADIUS_METERS=15000
# Empty uses the Vite proxy (development) or same-origin Nginx (Docker).
VITE_API_BASE_URL=
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Fallback when URL and browser languages are unsupported. Build-time setting.
VITE_DEFAULT_LOCALE=fr
